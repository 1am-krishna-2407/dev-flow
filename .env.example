# DevFlow Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — must be at least 32 characters for HS256
DEVFLOW_JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
DEVFLOW_JWT_EXPIRATION_MS=900000

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/devflow
SPRING_DATASOURCE_USERNAME=devflow
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
